# Copy to .dev.vars for local `wrangler dev` testing (gitignored). For the deployed
# Worker, set the same names with `wrangler secret put <NAME>` instead - see README.md.

# Firebase Console -> Project Settings -> Service Accounts -> Generate new private key.
# That JSON file contains project_id, client_email, and private_key - copy them here.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END PRIVATE KEY-----\n"

# aistudio.google.com/apikey - free tier, no credit card required.
GEMINI_API_KEY=your-gemini-api-key

# Any long random string you generate yourself - protects the /set-clinic-role admin
# endpoint. Not a Google/Firebase value.
ADMIN_SECRET=your-own-random-secret
