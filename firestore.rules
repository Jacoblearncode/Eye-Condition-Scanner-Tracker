rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    // request.auth.token.role is a custom claim set by the clinic dashboard's
    // backend (Cloud Function/Admin SDK). Nobody has this claim yet, so this
    // safely evaluates to false until that piece is built.
    function isClinicStaff() {
      return isSignedIn() && request.auth.token.role in ['clinic', 'admin'];
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId) || isClinicStaff();
    }

    match /patients/{patientId} {
      allow read, write: if isOwner(patientId) || isClinicStaff();

      match /scans/{scanId} {
        allow read: if isOwner(patientId) || isClinicStaff();
        // Patients may only create a scan record, never edit one afterward -
        // doctorNote and aiAnalysis.finalSeverity are clinic-only fields.
        allow create: if isOwner(patientId);
        allow update: if isClinicStaff();
      }

      match /milestones/{milestoneId} {
        allow read: if isOwner(patientId) || isClinicStaff();
        allow write: if isClinicStaff();
      }
    }

    match /clinics/{clinicId} {
      allow read: if isSignedIn();
      allow write: if isClinicStaff();
    }

    match /appointments/{appointmentId} {
      allow read: if isSignedIn() &&
        (resource.data.patientId == request.auth.uid || isClinicStaff());
      allow create: if isOwner(request.resource.data.patientId);
      allow update: if isClinicStaff();
    }

    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.recipientId);
      allow write: if isClinicStaff();
    }
  }
}
